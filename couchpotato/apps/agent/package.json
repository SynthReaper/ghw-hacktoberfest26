{
  "name": "couchpotato-agent",
  "version": "1.0.0",
  "description": "Mastra Agent framework orchestrating durable multi-step invoice hunting with Stagehand, Gemma 2, and TabPFN",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "hunt": "tsx src/index.ts --hunt",
    "test": "tsx --test tests/*.test.ts",
    "test:gemma": "tsx --test tests/gemma.test.ts",
    "test:workflow": "tsx --test tests/workflow.test.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.1.0",
    "@browserbasehq/stagehand": "^2.4.0",
    "@mastra/core": "^0.1.20",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "@sentry/node": "^8.40.0",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

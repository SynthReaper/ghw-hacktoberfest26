# NecroGit — Environment Configuration Example

# Mastra & Agent Settings
PORT=4112
MASTRA_APP_URL=http://localhost:4112
SEANCE_SIMULATION_MODE=false # Set true to run in offline mock mode without cloud credentials

# Ollama / Local Gemma 2 Settings (100% Privacy & Zero Cloud Leakage)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=gemma2:9b # or gemma2:2b

# Prior Labs TabPFN-3.5 FastMCP Settings (Bitrot & Anomaly Forensics)
TABPFN_MCP_PORT=8002
TABPFN_SERVER_URL=http://localhost:8002/mcp

# Browserbase & Stagehand Settings (Wayback Machine Crypt Hunter)
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
STAGEHAND_ENV=BROWSERBASE # or LOCAL for local playwright execution

# ElevenLabs Settings (Spectral Séance Voice Synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM # or custom eerie narrator voice

# Sentry Agent Tracing & Telemetry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Local Storage Paths
GRAVEYARD_DIR=./graveyard
RESURRECTED_DIR=./storage/resurrected
LEDGER_PATH=./storage/graveyard_ledger.json
BENCHMARK_CSV_PATH=./services/tabpfn-service/data/graveyard_benchmark.csv

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-Switch dataset row (one JSON object per line in JSONL)",
  "type": "object",
  "required": ["id", "input", "reference"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "system_prompt": { "type": "string", "maxLength": 20000 },
    "input": {
      "description": "User input text, or a list of chat messages.",
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 50000 },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": { "enum": ["system", "user", "assistant"] },
              "content": { "type": "string" }
            }
          }
        }
      ]
    },
    "reference": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "reference_source": {
      "enum": ["human", "closed_api", "open_model", "unknown"],
      "default": "unknown"
    },
    "train_allowed": {
      "type": "boolean",
      "description": "Defaults: human=true, open_model=true, closed_api=false, unknown=false. Overriding to true on closed_api/unknown requires an attestation recorded in the experiment."
    },
    "meta": { "type": "object" }
  }
}
